{
  "name": "lmcore-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for XJTLU Learning Mall Core (core.xjtlu.edu.cn), authenticated with a browser session.",
  "type": "module",
  "bin": {
    "lmcore-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "login": "tsc && node build/login.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --experimental-test-module-mocks --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@xberg-io/xberg": "1.3.10",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "puppeteer-core": "^25.13.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
